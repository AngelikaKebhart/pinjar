{
  "name": "pinjar",
  "description": "Universal, shop-independent wishlist: save any page with one click and organize saved links with categories, tags, status and notes.",
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "edge-extension",
    "wxt",
    "manifest-v3",
    "wishlist",
    "bookmarks",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/AngelikaKebhart/pinjar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AngelikaKebhart/pinjar.git"
  },
  "bugs": {
    "url": "https://github.com/AngelikaKebhart/pinjar/issues"
  },
  "author": "Angelika Kebhart",
  "license": "MIT",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:icon": "node scripts/build-icon.mjs",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "test:watch": "vitest",
    "prepare": "git config core.hooksPath .githooks || true",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  }
}
