#!/bin/sh
#
# Blocks direct pushes to the protected branch.
#
# A ruleset on GitHub is what actually protects main: it rejects the push at the
# remote, for everyone, and no local setting can talk it out of that. This hook
# is the earlier and friendlier half of the same rule — it stops the push before
# it leaves the machine, names the workflow, and spells out the two commands to
# do it properly, which a rejection from the server does not.
#
# So it is a reminder, not the enforcement. Removing it would cost nothing but
# the better error message.
#
# Enabled via `git config core.hooksPath .githooks` (done by the "prepare"
# script in package.json). `git push --no-verify` skips this hook — the ruleset
# on the remote does not care, and rejects the push anyway.

protected_branch='main'

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/$protected_branch" ]; then
    echo "" >&2
    echo "  Direct push to '$protected_branch' is blocked." >&2
    echo "" >&2
    echo "  Create a feature branch and open a pull request instead:" >&2
    echo "    git switch -c feature/my-change" >&2
    echo "    git push -u origin feature/my-change" >&2
    echo "" >&2
    echo "  To bypass deliberately: git push --no-verify" >&2
    echo "" >&2
    exit 1
  fi
done

exit 0
